{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "plan",
  "experimental": {
    "disable_paste_summary": true,
  },
  "permission": {
    "bash": {
      // git
      "git *": "deny",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      // npm
      "npm *": "deny",
      "npm install": "allow",
      "npm start": "allow",
      "npm test": "allow",
      "npm ci *": "allow",
      "npm install *": "ask",
      "npm run *": "allow",
      // npx
      "npx *": "deny"
    }
  }
}
